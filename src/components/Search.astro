---
// Site search. Pagefind indexes the built HTML (scripts/index-search.mjs) and ships a chunked
// index, so the client only downloads the fragments a query actually touches — the alternative,
// one JSON blob of 96 documents, is ~800 KB of prose nobody pays for until they search.
//
// The bundle is loaded lazily on first intent (hover/focus/open), the same trick Mermaid.astro
// uses: nothing on the critical path of a page that never gets searched.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<button id="s-open" class="s-trigger" type="button" aria-label="Search documentation" data-base={base}>
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.6-3.6" />
  </svg>
  <span class="s-trigger-label">Search</span>
  <kbd class="s-kbd">/</kbd>
</button>

<dialog id="s-modal" aria-label="Search documentation">
  <div class="s-head">
    <svg class="s-head-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.6-3.6" />
    </svg>
    <input
      id="s-input"
      type="text"
      placeholder="Search the documentation…"
      aria-label="Search the documentation"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="s-results"
      aria-autocomplete="list"
    />
    <button id="s-close" class="s-esc" type="button" aria-label="Close search">Esc</button>
  </div>

  <div id="s-filters" class="s-filters" role="group" aria-label="Filter by section" hidden></div>

  <div id="s-results" class="s-results" role="listbox" aria-label="Search results">
    <p class="s-msg">Type to search across the guides, specification and decision records.</p>
  </div>

  <div class="s-foot">
    <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
    <span><kbd>↵</kbd> open</span>
    <span><kbd>esc</kbd> close</span>
    <span class="s-by">Pagefind</span>
  </div>
</dialog>

<script>
  // The elements are taken as parameters rather than read inside: a `null` check at the call site
  // does not narrow through into nested closures, so every use below would otherwise be
  // `possibly null` to the type checker.
  function init(
    trigger: HTMLButtonElement,
    modal: HTMLDialogElement,
    input: HTMLInputElement,
    results: HTMLDivElement,
    filterBar: HTMLDivElement,
    closeBtn: HTMLElement | null,
  ) {
    // `base` is a build-time value, handed to this bundled script through the trigger's data
    // attribute — one source of truth with astro.config.mjs.
    const base = trigger.dataset.base ?? "";

    // Sidebar reading order, reused so the filter chips are not alphabetical either.
    const ORDER = ["Start here", "Guides", "Reference", "Specification", "Decision records"];

    let pagefind: any = null;
    let loading: Promise<any> | null = null;
    let activeFilter: string | null = null;
    let hits: HTMLAnchorElement[] = [];
    let cursor = -1;
    let generation = 0;

    /** Load the index bundle once, on first intent. */
    function load(): Promise<any> {
      if (loading) return loading;
      loading = (async () => {
        // A runtime URL, so Vite leaves it alone — the bundle is emitted by Pagefind, not by us.
        const mod = await import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`);
        // `baseUrl` is what Pagefind prepends to every result URL — it already accounts for
        // astro.config's `base`, so the URLs below must NOT be prefixed a second time.
        await mod.options({ basePath: `${base}/pagefind/`, baseUrl: `${base}/`, excerptLength: 22 });
        await mod.init();
        pagefind = mod;
        void buildFilters();
        return mod;
      })().catch((err) => {
        loading = null;
        throw err;
      });
      return loading;
    }

    async function buildFilters() {
      const counts = await pagefind.filters();
      const sections: Record<string, number> = counts?.section ?? {};
      // A section the sync script grows later is unknown to ORDER; sort it last, not first,
      // which is what a bare indexOf's -1 would do.
      const rank = (n: string) => (ORDER.indexOf(n) + 1 || Infinity);
      const names = Object.keys(sections)
        .filter((n) => sections[n] > 0)
        .sort((a, b) => rank(a) - rank(b));
      if (names.length < 2) return;

      filterBar.innerHTML = "";
      for (const name of [null, ...names]) {
        const chip = document.createElement("button");
        chip.type = "button";
        chip.className = "s-chip";
        chip.dataset.filter = name ?? "";
        chip.textContent = name === null ? "All" : name;
        if (name !== null) {
          const n = document.createElement("span");
          n.className = "s-chip-n";
          n.textContent = String(sections[name]);
          chip.appendChild(n);
        }
        chip.setAttribute("aria-pressed", String(activeFilter === name));
        chip.addEventListener("click", () => {
          activeFilter = name;
          for (const el of filterBar.querySelectorAll<HTMLButtonElement>(".s-chip")) {
            el.setAttribute("aria-pressed", String((el.dataset.filter || null) === activeFilter));
          }
          void search();
        });
        filterBar.appendChild(chip);
      }
      filterBar.hidden = false;
    }

    function message(text: string) {
      results.innerHTML = "";
      const p = document.createElement("p");
      p.className = "s-msg";
      p.textContent = text;
      results.appendChild(p);
      hits = [];
      cursor = -1;
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
    }

    async function search() {
      const term = input.value.trim();
      if (!term) {
        message("Type to search across the guides, specification and decision records.");
        return;
      }

      const mine = ++generation;
      let pf: any;
      try {
        pf = await load();
      } catch {
        message("Search index unavailable — run `pnpm build` to generate it.");
        return;
      }
      if (mine !== generation) return;

      const opts = activeFilter ? { filters: { section: [activeFilter] } } : {};
      const res = await pf.debouncedSearch(term, opts, 160);
      // Pagefind returns null when a later keystroke superseded this search.
      if (res === null || mine !== generation) return;

      // Ten pages is already more than anyone scrolls in a search box; the sub-results below each
      // one are where the real precision lives.
      const data = await Promise.all(res.results.slice(0, 10).map((r: any) => r.data()));
      if (mine !== generation) return;

      if (data.length === 0) {
        message(`No matches for “${term}”.`);
        return;
      }
      render(data);
    }

    function render(data: any[]) {
      results.innerHTML = "";
      hits = [];

      for (const d of data) {
        const group = document.createElement("div");
        group.className = "s-group";

        const page = link(d.url);
        page.innerHTML =
          `<span class="s-sec">${escapeHtml(d.meta?.section ?? "Docs")}</span>` +
          `<span class="s-title">${escapeHtml(d.meta?.title ?? d.url)}</span>` +
          `<span class="s-ex">${d.excerpt}</span>`;
        group.appendChild(page);

        // Heading-level hits: the anchor ids already exist in the rendered markdown, so these
        // deep-link straight to the paragraph rather than the top of a 1600-line guide.
        const subs = (d.sub_results ?? []).filter((s: any) => s.anchor).slice(0, 3);
        for (const s of subs) {
          const sub = link(s.url);
          sub.classList.add("s-sub");
          sub.innerHTML =
            `<span class="s-title">${escapeHtml(s.title)}</span>` +
            `<span class="s-ex">${s.excerpt}</span>`;
          group.appendChild(sub);
        }

        results.appendChild(group);
      }

      cursor = -1;
      input.setAttribute("aria-expanded", "true");
      input.removeAttribute("aria-activedescendant");
    }

    function link(href: string): HTMLAnchorElement {
      const a = document.createElement("a");
      a.className = "s-hit";
      a.href = href;
      a.id = `s-hit-${hits.length}`;
      a.setAttribute("role", "option");
      a.setAttribute("aria-selected", "false");
      a.addEventListener("mousemove", () => move(hits.indexOf(a), false));
      hits.push(a);
      return a;
    }

    function escapeHtml(s: string): string {
      const d = document.createElement("div");
      d.textContent = s;
      return d.innerHTML;
    }

    function move(next: number, scroll = true) {
      if (hits.length === 0) return;
      const i = ((next % hits.length) + hits.length) % hits.length;
      if (i === cursor) return;
      hits[cursor]?.setAttribute("aria-selected", "false");
      hits[cursor]?.classList.remove("on");
      cursor = i;
      hits[cursor].setAttribute("aria-selected", "true");
      hits[cursor].classList.add("on");
      input.setAttribute("aria-activedescendant", hits[cursor].id);
      if (scroll) hits[cursor].scrollIntoView({ block: "nearest" });
    }

    function open() {
      if (modal.open) return;
      modal.showModal();
      input.focus();
      input.select();
    }

    trigger.addEventListener("click", open);
    trigger.addEventListener("pointerenter", () => void load().catch(() => {}));
    trigger.addEventListener("focus", () => void load().catch(() => {}));
    closeBtn?.addEventListener("click", () => modal.close());

    // Clicking the backdrop closes: the dialog itself fills only part of the top layer, so a
    // click landing on the <dialog> element rather than its content is a click outside the panel.
    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });

    // Hand focus back to the invoker. Without this the closed dialog's input can keep focus,
    // and the `/` shortcut below then reads the page as "being typed into" and stops responding.
    modal.addEventListener("close", () => trigger.focus());

    input.addEventListener("input", () => void search());

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); move(cursor + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); move(cursor - 1); }
      else if (e.key === "Enter" && cursor >= 0) { e.preventDefault(); hits[cursor].click(); }
      else if (e.key === "Home" && hits.length) { e.preventDefault(); move(0); }
      else if (e.key === "End" && hits.length) { e.preventDefault(); move(hits.length - 1); }
    });

    // `/` is the docs-site convention; ⌘K/Ctrl-K for people who expect a command palette.
    addEventListener("keydown", (e) => {
      const el = document.activeElement;
      const typing =
        el instanceof HTMLInputElement ||
        el instanceof HTMLTextAreaElement ||
        (el instanceof HTMLElement && el.isContentEditable);
      if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        open();
      } else if (e.key === "/" && !typing && !e.metaKey && !e.ctrlKey && !e.altKey) {
        e.preventDefault();
        open();
      }
    });
  }

  const trigger = document.getElementById("s-open") as HTMLButtonElement | null;
  const modal = document.getElementById("s-modal") as HTMLDialogElement | null;
  const input = document.getElementById("s-input") as HTMLInputElement | null;
  const results = document.getElementById("s-results") as HTMLDivElement | null;
  const filterBar = document.getElementById("s-filters") as HTMLDivElement | null;

  if (trigger && modal && input && results && filterBar) {
    init(trigger, modal, input, results, filterBar, document.getElementById("s-close"));
  }
</script>

<style is:global>
  /* Trigger ----------------------------------------------------------------- */
  .s-trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 34px;
    padding: 0 0.5rem 0 0.65rem;
    min-width: 200px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    color: var(--text-faint);
    font: inherit;
    font-size: 0.86rem;
    cursor: pointer;
  }
  .s-trigger:hover { color: var(--text-dim); border-color: var(--border-strong); }
  .s-trigger-label { margin-right: auto; }
  .s-kbd,
  .s-foot kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1;
    color: var(--text-faint);
    background: var(--bg-inset);
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 5px;
    padding: 0.2rem 0.35rem;
    min-width: 1.3em;
    text-align: center;
  }

  /* Dialog ------------------------------------------------------------------ */
  #s-modal {
    width: min(640px, calc(100vw - 2rem));
    max-height: min(70vh, 640px);
    margin: 12vh auto auto;
    padding: 0;
    display: none;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    background: var(--bg-raised);
    color: var(--text);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  #s-modal[open] { display: flex; }
  #s-modal::backdrop {
    background: rgba(4, 6, 10, 0.6);
    backdrop-filter: blur(3px);
  }
  /* ::backdrop does not inherit the page's custom properties, so the light theme needs its own
     scrim — the dark one turns a white page muddy. */
  :root[data-theme="light"] #s-modal::backdrop { background: rgba(16, 20, 28, 0.32); }
  :root[data-theme="light"] #s-modal { box-shadow: 0 24px 60px rgba(16, 20, 28, 0.18); }

  .s-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  .s-head-icon { color: var(--text-faint); flex: none; }
  #s-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    outline: none;
  }
  #s-input::placeholder { color: var(--text-faint); }
  .s-esc {
    flex: none;
    font: inherit;
    font-size: 0.72rem;
    color: var(--text-faint);
    background: var(--bg-inset);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.22rem 0.45rem;
    cursor: pointer;
  }
  .s-esc:hover { color: var(--text-dim); border-color: var(--border-strong); }

  .s-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  .s-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font: inherit;
    font-size: 0.76rem;
    color: var(--text-dim);
    background: var(--bg-inset);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    cursor: pointer;
  }
  .s-chip:hover { color: var(--text); border-color: var(--border-strong); }
  .s-chip[aria-pressed="true"] {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .s-chip-n { color: var(--text-faint); font-size: 0.68rem; }

  /* Results ----------------------------------------------------------------- */
  .s-results { overflow-y: auto; padding: 0.5rem; flex: 1; }
  .s-msg { margin: 0; padding: 1.4rem 0.8rem; color: var(--text-faint); font-size: 0.87rem; }
  .s-group { margin-bottom: 0.4rem; }

  .s-hit {
    display: block;
    padding: 0.55rem 0.7rem;
    border-radius: 9px;
    border: 1px solid transparent;
    color: var(--text);
  }
  .s-hit:hover, .s-hit.on { text-decoration: none; }
  .s-hit.on {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .s-sec {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.63rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 0.15rem;
  }
  .s-title {
    display: block;
    font-size: 0.92rem;
    font-weight: 620;
    color: var(--text);
  }
  .s-ex {
    display: block;
    margin-top: 0.18rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-dim);
  }
  .s-ex mark {
    background: none;
    color: var(--accent);
    font-weight: 650;
  }
  .s-sub {
    margin-left: 0.9rem;
    border-left: 1px solid var(--border);
    border-radius: 0 9px 9px 0;
  }
  .s-sub .s-title {
    font-size: 0.85rem;
    font-weight: 560;
    color: var(--text-dim);
  }
  .s-sub .s-title::before { content: "# "; color: var(--text-faint); }
  .s-sub.on .s-title { color: var(--text); }

  .s-foot {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.5rem 0.8rem;
    border-top: 1px solid var(--border);
    font-size: 0.72rem;
    color: var(--text-faint);
  }
  .s-foot span { display: inline-flex; align-items: center; gap: 0.25rem; }
  .s-by { margin-left: auto; }

  /* The nav links and the trigger compete for the same row before the nav collapses. */
  @media (max-width: 1080px) {
    .s-trigger { min-width: 132px; }
  }
  @media (max-width: 860px) {
    .s-trigger { min-width: 0; padding: 0 0.55rem; }
    .s-trigger-label, .s-kbd { display: none; }
    #s-modal { margin-top: 6vh; max-height: 80vh; }
  }
</style>
