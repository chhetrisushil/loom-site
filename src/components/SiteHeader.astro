---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname;
const isDocs = path.includes("/docs");
---

<header class="hdr">
  <div class="hdr-in">
    <a class="brand" href={`${base}/`}>
      <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true">
        <defs>
          <linearGradient id="lg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#f0a742" />
            <stop offset="55%" stop-color="#e0725f" />
            <stop offset="100%" stop-color="#a06bff" />
          </linearGradient>
        </defs>
        <!-- warp threads crossed by a weft: a loom -->
        <g stroke="url(#lg)" stroke-width="2.4" stroke-linecap="round" fill="none">
          <path d="M7 4v24M16 4v24M25 4v24" opacity="0.55" />
          <path d="M3 11c5 4 21 4 26 0M3 21c5 4 21 4 26 0" />
        </g>
      </svg>
      <span>Loom</span>
    </a>

    <nav class="nav" aria-label="Main">
      <a href={`${base}/docs/getting-started`} class={isDocs ? "on" : ""}>Docs</a>
      <a href={`${base}/docs/architecture`}>Architecture</a>
      <a href={`${base}/docs/adr`}>Decisions</a>
      <a href={`${base}/docs/examples`}>Examples</a>
    </nav>

    <div class="right">
      <button id="theme" class="icon" type="button" aria-label="Toggle colour theme">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
        </svg>
      </button>
      <button id="navtoggle" class="icon only-narrow" type="button" aria-label="Toggle navigation" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .hdr-in {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.25rem;
    height: 60px;
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 700;
    font-size: 1.06rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .brand:hover { text-decoration: none; }
  .nav { display: flex; gap: 1.4rem; font-size: 0.92rem; margin-right: auto; }
  .nav a { color: var(--text-dim); font-weight: 500; }
  .nav a:hover, .nav a.on { color: var(--text); text-decoration: none; }
  .nav a.on { color: var(--accent); }
  .right { display: flex; align-items: center; gap: 0.4rem; }
  .icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    color: var(--text-dim);
    cursor: pointer;
  }
  .icon:hover { color: var(--text); border-color: var(--border-strong); }
  .only-narrow { display: none; }

  @media (max-width: 860px) {
    .nav { display: none; }
    .only-narrow { display: grid; }
  }
</style>

<script>
  // Theme: honour an explicit choice, else the OS. Set before paint in Layout to avoid a flash.
  const btn = document.getElementById("theme");
  btn?.addEventListener("click", () => {
    const now = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = now;
    try { localStorage.setItem("loom-theme", now); } catch {}
  });

  const toggle = document.getElementById("navtoggle");
  toggle?.addEventListener("click", () => {
    const open = document.body.classList.toggle("nav-open");
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
