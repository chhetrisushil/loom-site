---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Mermaid from "../../components/Mermaid.astro";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry, docs } }));
}

interface Props { entry: CollectionEntry<"docs">; docs: CollectionEntry<"docs">[]; }
const { entry, docs } = Astro.props;
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Sidebar sections in a deliberate reading order, not alphabetical.
const ORDER = ["Start here", "Guides", "Reference", "Specification", "Decision records"];
const sections = ORDER.map((name) => ({
  name,
  items: docs
    .filter((d) => d.data.section === name)
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)),
})).filter((s) => s.items.length > 0);

// Decision records are 77 entries — collapsed by default so they never bury the guides.
const isBulk = (name: string) => name === "Decision records";
const inBulk = isBulk(entry.data.section);

// h2/h3 only: h4+ makes the rail unreadable on long pages like the user guide.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const repoUrl = entry.data.source
  ? `https://github.com/chhetrisushil/loom/blob/main/${entry.data.source}`
  : undefined;
---

<Base title={`${entry.data.title} — Loom`}>
  <div class="wrap">
    <aside class="side" aria-label="Documentation">
      <nav>
        {sections.map((s) => (
          <details open={!isBulk(s.name) || inBulk} class="sec">
            <summary>{s.name}<span class="count">{s.items.length}</span></summary>
            <ul>
              {s.items.map((d) => (
                <li>
                  <a href={`${base}/docs/${d.id}`} class={d.id === entry.id ? "on" : ""}>
                    {d.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </nav>
    </aside>

    {/*
      `data-pagefind-body` scopes the search index to the article — chrome (header, sidebar,
      footer) would otherwise be indexed 96 times over. It also opts the *page* in: with the
      attribute present anywhere on the site, Pagefind indexes only pages that carry it, which is
      how the landing page and the two index pages stay out of the results.
    */}
    <article
      class="doc"
      data-pagefind-body
      data-pagefind-meta={`section:${entry.data.section}`}
      data-pagefind-filter={`section:${entry.data.section}`}
    >
      <p class="crumb">{entry.data.section}</p>
      <h1>{entry.data.title}</h1>
      <div class="prose"><Content /></div>
      <Mermaid />
      {repoUrl && (
        <p class="edit">
          Source: <a href={repoUrl} rel="noopener">{entry.data.source}</a> in the loom repository.
        </p>
      )}
    </article>

    {toc.length > 2 && (
      <aside class="toc" aria-label="On this page">
        <p class="toc-h">On this page</p>
        <ul>
          {toc.map((h) => (
            <li class={h.depth === 3 ? "d3" : ""}><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</Base>

<style is:global>
  /* Rendered markdown ------------------------------------------------------- */
  .prose { font-size: 0.97rem; }
  .prose h2 {
    font-size: 1.42rem;
    margin: 2.6rem 0 0.85rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
  }
  .prose h3 { font-size: 1.12rem; margin: 1.9rem 0 0.6rem; }
  .prose h4 { font-size: 1rem; margin: 1.5rem 0 0.5rem; color: var(--text-dim); }
  .prose p, .prose li { color: var(--text-dim); }
  .prose strong { color: var(--text); font-weight: 620; }
  .prose ul, .prose ol { padding-left: 1.3rem; }
  .prose li { margin: 0.3rem 0; }
  .prose blockquote {
    margin: 1.2rem 0;
    padding: 0.15rem 1.1rem;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 8px 8px 0;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.2rem 0;
    font-size: 0.89rem;
    display: block;
    overflow-x: auto;
  }
  .prose th, .prose td {
    border: 1px solid var(--border);
    padding: 0.5rem 0.7rem;
    text-align: left;
    vertical-align: top;
  }
  .prose th { background: var(--bg-raised); color: var(--text); font-weight: 620; }
  .prose td { color: var(--text-dim); }
  .prose img { max-width: 100%; height: auto; border-radius: 8px; }
  .prose hr { border: 0; border-top: 1px solid var(--border); margin: 2rem 0; }
  .prose pre { margin: 1.1rem 0; }
  /* Anchor targets clear the sticky header. */
  .prose :is(h2, h3, h4)[id] { scroll-margin-top: 84px; }
</style>

<style>
  .wrap {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr) var(--toc-w);
    gap: 2.5rem;
    align-items: start;
  }

  .side {
    position: sticky;
    top: 60px;
    max-height: calc(100vh - 60px);
    overflow-y: auto;
    padding: 1.5rem 0 3rem;
    border-right: 1px solid var(--border);
    font-size: 0.88rem;
  }
  .sec { margin-bottom: 0.4rem; }
  .sec summary {
    cursor: pointer;
    list-style: none;
    font-weight: 650;
    color: var(--text);
    padding: 0.4rem 0.5rem;
    border-radius: 6px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .sec summary::-webkit-details-marker { display: none; }
  .sec summary:hover { background: var(--bg-raised); }
  .count {
    margin-left: auto;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-faint);
    background: var(--bg-inset);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.05rem 0.42rem;
  }
  .side ul { list-style: none; margin: 0.15rem 0 0.9rem; padding: 0 0 0 0.5rem; }
  .side li { margin: 0; }
  .side li a {
    display: block;
    padding: 0.32rem 0.55rem;
    border-radius: 6px;
    color: var(--text-dim);
    border-left: 2px solid transparent;
  }
  .side li a:hover { color: var(--text); background: var(--bg-raised); text-decoration: none; }
  .side li a.on {
    color: var(--accent);
    border-left-color: var(--accent);
    background: var(--accent-soft);
    font-weight: 600;
  }

  .doc { padding: 2rem 0 4rem; min-width: 0; }
  .crumb {
    text-transform: uppercase;
    letter-spacing: 0.11em;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  .doc h1 { font-size: clamp(1.8rem, 3.4vw, 2.3rem); margin: 0 0 1.6rem; }
  .edit {
    margin-top: 3rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  .toc {
    position: sticky;
    top: 76px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    padding: 2rem 0;
    font-size: 0.83rem;
  }
  .toc-h {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.69rem;
    font-weight: 700;
    color: var(--text-faint);
    margin: 0 0 0.6rem;
  }
  .toc ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--border); }
  .toc li a { display: block; padding: 0.22rem 0 0.22rem 0.75rem; color: var(--text-dim); }
  .toc li a:hover { color: var(--accent); text-decoration: none; }
  .toc .d3 a { padding-left: 1.5rem; font-size: 0.95em; color: var(--text-faint); }

  @media (max-width: 1180px) {
    .wrap { grid-template-columns: var(--sidebar-w) minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 860px) {
    .wrap { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .side {
      display: none;
      position: static;
      max-height: none;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    :global(body.nav-open) .side { display: block; }
  }
</style>
