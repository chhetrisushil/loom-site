---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const docs = await getCollection("docs");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ORDER = ["Start here", "Guides", "Reference", "Specification", "Decision records"];
const BLURB: Record<string, string> = {
  "Start here": "Install it, build a first flow, suspend it for a human, resume it.",
  Guides: "Look up a feature — CLI, plugins, scaling, benchmarks, the transient interpreter.",
  Reference: "Architecture, data classification, compliance and governance.",
  Specification: "The normative contract: what the kernel guarantees, and the evidence for it.",
  "Decision records": "Every architectural trade-off, written down with the reasoning and the rejected alternatives.",
};
const sections = ORDER.map((name) => ({
  name,
  blurb: BLURB[name],
  items: docs
    .filter((d) => d.data.section === name)
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)),
})).filter((s) => s.items.length > 0);
---

<Base title="Documentation — Loom">
  <div class="shell hub">
    <p class="crumb">Documentation</p>
    <h1>Everything, in reading order</h1>
    <p class="lede">
      The docs are a progressive funnel — start at the top, or jump to what you need. Every page
      is generated from the loom repository, so it tracks the code rather than describing it from
      memory.
    </p>

    {sections.map((s) => (
      <section class="sec">
        <div class="sec-h">
          <h2>{s.name}</h2>
          <p>{s.blurb}</p>
        </div>
        {s.name === "Decision records" ? (
          <p class="bulk">
            <a class="btn btn-ghost" href={`${base}/docs/adr`}>Browse all {s.items.length} decision records →</a>
          </p>
        ) : (
          <ul class="cards">
            {s.items.map((d) => (
              <li>
                <a href={`${base}/docs/${d.id}`}>{d.data.title}</a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>
</Base>

<style>
  .hub { padding: 3rem 0 4rem; }
  .crumb { text-transform: uppercase; letter-spacing: 0.11em; font-size: 0.7rem; font-weight: 700; color: var(--accent); margin: 0 0 0.5rem; }
  h1 { font-size: clamp(1.9rem, 4vw, 2.5rem); margin: 0 0 0.9rem; }
  .lede { color: var(--text-dim); max-width: 64ch; margin: 0 0 3rem; }
  .sec { margin-bottom: 2.8rem; }
  .sec-h h2 { font-size: 1.25rem; margin: 0 0 0.25rem; }
  .sec-h p { color: var(--text-faint); font-size: 0.9rem; margin: 0 0 1rem; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.6rem; }
  .cards a {
    display: block;
    padding: 0.8rem 1rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    font-size: 0.93rem;
    font-weight: 550;
  }
  .cards a:hover { border-color: var(--accent); text-decoration: none; }
  .bulk { margin: 0; }
</style>
